# Maestro release signing credentials template (Sprint C C0-2).
# Copy to .env (git-ignored) for local signed builds, or set as CI secrets.
# NEVER commit real values.

# Windows Authenticode (C1-6): base64 of the PFX, or a local path instead.
WINDOWS_CERT_PFX=
WINDOWS_CERT_PFX_PATH=
WINDOWS_CERT_PASSWORD=

# macOS Developer ID (C2): keychain holds the cert on dev Macs; CI can use
# a base64 .p12 imported at build time.
MACOS_DEVELOPER_ID_P12=
MACOS_DEVELOPER_ID_P12_PASSWORD=

# macOS notarization (C2-5): stored keychain profile preferred on dev Macs;
# CI uses the App-specific password / API key trio.
MACOS_NOTARY_PROFILE=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Linux repo metadata GPG (C4): signing key for deb/rpm repositories.
LINUX_GPG_KEY=
LINUX_GPG_KEY_PASSWORD=
